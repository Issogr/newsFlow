# Ignore everything, then include only BFF and frontend build inputs.
*
!bff/
!bff/Dockerfile
!bff/package*.json
!bff/tsconfig*.json
!bff/server.ts
!bff/lib/
!bff/lib/**
!frontend/
!frontend/package*.json
!frontend/index.html
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/public/
!frontend/public/**
!frontend/src/
!frontend/src/**

# Source trees contain test-only files that production builds do not need.
**/*.test.*
**/*.spec.*
**/__tests__
**/__snapshots__
frontend/src/setupTests.ts
frontend/src/test-utils

# Never send local credentials accidentally stored in an included directory.
**/.env*
**/.npmrc
**/.netrc
**/*.key
**/*.pem
**/*.p12
**/*.pfx
