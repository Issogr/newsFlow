# Ignore everything, then include only backend and frontend build inputs.
*
!backend/
!backend/Dockerfile
!backend/package*.json
!backend/tsconfig*.json
!backend/app.ts
!backend/server.ts
!backend/config/
!backend/config/**
!backend/routes/
!backend/routes/**
!backend/services/
!backend/services/**
!backend/utils/
!backend/utils/**
!frontend/
!frontend/package*.json
!frontend/index.html
!frontend/tsconfig.json
!frontend/vite.config.mts
!frontend/public/
!frontend/public/**
!frontend/src/
!frontend/src/**

# Keep local installs, data, logs, coverage, and prior builds out of the context.
backend/node_modules
backend/data
backend/dist
backend/logs
backend/coverage
frontend/node_modules
frontend/dist
frontend/build
frontend/.vite
frontend/coverage

# Source trees contain test-only files that production builds do not need.
**/*.test.*
**/*.spec.*
**/__tests__
**/__snapshots__
frontend/src/setupTests.ts
frontend/src/test-utils

# Never send local credentials accidentally stored in an included directory.
**/.env*
**/.npmrc
**/.netrc
**/*.key
**/*.pem
**/*.p12
**/*.pfx
