# Ignore everything, then include only backend build inputs.
*
!Dockerfile
!package*.json
!tsconfig*.json
!server.ts
!config/
!config/**
!routes/
!routes/**
!services/
!services/**
!utils/
!utils/**

# Source directories contain test-only files that production builds do not need.
**/*.test.*
**/*.spec.*
**/__tests__
**/__snapshots__

# Never send local credentials accidentally stored in an included directory.
**/.env*
**/.npmrc
**/.netrc
**/*.key
**/*.pem
**/*.p12
**/*.pfx
