{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true
  },
  "include": ["app.ts", "server.ts", "config/**/*.ts", "routes/**/*.ts", "services/**/*.ts", "utils/**/*.ts"],
  "exclude": ["**/*.test.ts", "dist", "node_modules", "test-utils"]
}
