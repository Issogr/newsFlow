{
  "name": "newsflow-backend",
  "private": true,
  "description": "Backend for news aggregator app with real-time updates",
  "main": "dist/server.js",
  "scripts": {
    "start": "node --enable-source-maps dist/server.js",
    "dev": "tsx watch server.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p ../scripts/tsconfig.json",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:coverage": "npm test -- --coverage",
    "eval:summaries": "tsx test-utils/summaryGrounding.eval.ts",
    "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest --watch"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.2.0",
    "html-entities": "^2.6.0",
    "jsdom": "^30.1.0",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "rss-parser": "^3.13.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.6",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": "^24.0.0"
  }
}
