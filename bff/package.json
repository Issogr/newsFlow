{
  "name": "newsflow-bff",
  "version": "3.4.2",
  "description": "Browser-facing BFF for News Flow",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "lint": "node --check server.js && for file in lib/*.js; do node --check \"$file\"; done",
    "test": "NODE_OPTIONS=--no-experimental-webstorage jest"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "better-sqlite3": "^12.10.0",
    "better-sqlite3-session-store": "^0.1.0",
    "cookie": "^1.1.1",
    "cookie-signature": "^1.2.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^4.0.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "^7.28.6",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.m?js$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(http-proxy-middleware|httpxy|is-plain-obj)/)"
    ]
  }
}
