{
  "name": "newsflow-bff",
  "version": "3.5.5",
  "description": "Browser-facing BFF for News Flow",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "lint": "eslint .",
    "test": "node ../scripts/run-jest.js"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "better-sqlite3": "^12.10.0",
    "cookie": "^1.1.1",
    "cookie-signature": "^1.2.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.2.0",
    "http-proxy-middleware": "^4.0.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "babel-jest": "^30.4.1",
    "eslint": "^10.4.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": "24.16.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.m?js$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(http-proxy-middleware|httpxy|is-plain-obj)/)"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "server.js",
      "lib/**/*.js"
    ],
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 55,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  }
}
